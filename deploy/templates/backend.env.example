DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=icqt.ac.ir,www.icqt.ac.ir,ayehh.ir,www.ayehh.ir,backend

CORS_ALLOWED_ORIGINS=https://icqt.ac.ir,https://www.icqt.ac.ir,https://ayehh.ir,https://www.ayehh.ir
CSRF_TRUSTED_ORIGINS=https://icqt.ac.ir,https://www.icqt.ac.ir,https://ayehh.ir,https://www.ayehh.ir

JWT_COOKIE_SECURE=true

# --- Finance / Vandar ---
VANDAR_SANDBOX_MODE=false
VANDAR_ALLOW_SANDBOX=false
VANDAR_API_KEY=
VANDAR_CALLBACK_URL=https://icqt.ac.ir/api/v1/finance/vandar/callback/
VANDAR_MIN_AMOUNT_IRR=1000
# Absolute frontend origin (scheme + host, no path). Required in production.
# A standard institute with no canonical domain returns to
# PLATFORM_FRONTEND_ORIGIN/i/<slug>/... after Vandar.
# Do not leave this empty: the callback will not emit a hostless /i/<slug>/...
# redirect for that case. Psychology (custom frontend) keeps its stored path.
PLATFORM_FRONTEND_ORIGIN=https://icqt.ac.ir