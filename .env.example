
# --- Django core ---
DJANGO_SECRET_KEY=django secret key
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://etrat:etrat@127.0.0.1:5432/etrat

# --- CORS / CSRF  ---
# Include Next.js fallback ports (3001+) — `next dev` hops if 3000 is taken.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- JWT cookies ---
JWT_COOKIE_SECURE=false

# --- Finance / Vandar ---
VANDAR_SANDBOX_MODE=false
VANDAR_API_KEY=
VANDAR_CALLBACK_URL=https://ayehh.ir/api/v1/finance/vandar/callback/
VANDAR_FRONTEND_SUCCESS_URL=https://ayehh.ir/patient/wallet/payment/success
VANDAR_FRONTEND_FAILURE_URL=https://ayehh.ir/patient/wallet/payment/failure
